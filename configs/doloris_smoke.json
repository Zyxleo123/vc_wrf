{
 "name": "smoke",
 "source": "configs/doloris_v1.json with a short run, for an end-to-end check of the pipeline only",
 "model": {
  "hidden_dim": 1024,
  "time_pos_dim": 1024,
  "gene_wise_embed_dim": 256,
  "mole_dim": 512
 },
 "diffusion": {
  "steps": 500,
  "respacing": 50,
  "clip_denoised": true
 },
 "train": {
  "steps": 400,
  "save_every": 200,
  "batch_size": 32,
  "lr": 0.0001,
  "weight_decay": 0.0
 },
 "mask": {
  "gene_init_dim": 64,
  "gat_heads": 2,
  "epochs": 1,
  "batch_size": 32,
  "lr": 0.01,
  "weight_decay": 0.01
 },
 "grn": {
  "threshold_co": 0.3,
  "n_cells": 500,
  "seed": 42
 },
 "inference": {
  "n_cells": 512,
  "mask_high": 0.99,
  "mask_low": 0.01,
  "mask_feature_topk": 300
 }
}
